{
  "name": "dsh-enter-remap",
  "version": "1.1.0",
  "type": "module",
  "description": "Remap Enter / Ctrl+Enter / Shift+Enter in the DSH composer so its three native behaviors (line break, Enter-key send, Ctrl+Enter-key send) stay one per key; customizable in settings.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "keyboard",
    "keymap",
    "composer"
  ],
  "license": "MIT",
  "author": "Goose-Gusi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Goose-Gusi/dsh-enter-remap.git"
  },
  "homepage": "https://github.com/Goose-Gusi/dsh-enter-remap#readme",
  "bugs": {
    "url": "https://github.com/Goose-Gusi/dsh-enter-remap/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
